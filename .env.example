WORKSHOP_ALLOWED_RECIPIENTS=
PORT=3004
AUTO_SEND_ENABLED=false
AGENTMAIL_POLL_SECONDS=30
WORKSHOP_PROFILE=participant
WORKSHOP_CHECKPOINT=drill-08-start
